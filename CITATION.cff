    value: "10.5281/zenodo.21536833"
    description: "DOI do Zenodo — todas as versões (resolve sempre para a mais recente)"
  - type: doi
    value: "10.5281/zenodo.21796720"
    description: "DOI do Zenodo desta versão (v1.3.0)"
  - type: doi
    value: "10.5281/zenodo.21610649"
    description: "DOI do Zenodo da v1.1.0"
  - type: doi
    value: "10.5281/zenodo.21536834"
    description: "DOI do Zenodo da v1.0.0"
license: MIT
